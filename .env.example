# Doppler Project: letsobserve

# 1. Add these secrets to Doppler (for the Hono backend worker):
RESTCOUNTRIES_API_KEY=your_restcountries_v5_api_key

# 2. Add these secrets to Doppler (for the Frontend Expo app):
EXPO_PUBLIC_API_URL=https://letsobserve-backend.your-subdomain.workers.dev

# 3. Add these secrets directly to GitHub Actions Secrets (Settings > Secrets and variables > Actions):
DOPPLER_TOKEN=dp.st.xxxx
CLOUDFLARE_API_TOKEN=xxxx
CLOUDFLARE_ACCOUNT_ID=xxxx
